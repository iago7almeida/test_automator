# ==============================================================================
# HML (Homologação) - Configuração Local
# ==============================================================================
# Este arquivo é ignorado pelo Git (.gitignore)
# Copie de .env.example e preencha com seus dados locais
# ==============================================================================

# Credenciais Web
USER=teste_teste@gmail.com
PASSWORD=123

# Credenciais API (tokens serão gerados dinamicamente)
API_USER=teste_teste@gmail.com
API_PASSWORD=123

# URLs Web
BASE_URL=https://homolog.pigz.com.br

# URLs API
API_BASE_URL=https://test.pigz.dev
API_ADMIN_BASE=https://test.pigz.dev/admin/api

# Tokens (deixar em branco para usar geração automática)
API_TOKEN=

# Browser
HEADLESS=false
BROWSER_CHANNEL=chromium
START_MAXIMIZED=true
PAGE_ZOOM=80

# Timeouts
DEFAULT_TIMEOUT=5000
LONG_TIMEOUT=15000
SHORT_TIMEOUT=2000

# Logging
LOG_LEVEL=INFO
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_PATH=./tests/screenshots

# Testes
PYTEST_WORKERS=1
STOP_ON_FIRST_FAILURE=false

# Integrações
WEBHOOK_URL=
