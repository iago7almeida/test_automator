# ==============================================================================
# PROD (Produção) - Configuração Local
# ==============================================================================
# Este arquivo é ignorado pelo Git (.gitignore)
# Copie de .env.example e preencha com seus dados locais
# ⚠️ CUIDADO: Credenciais de PRODUÇÃO - NUNCA versione!
# ==============================================================================

# Credenciais Web
USER=
PASSWORD=

# Credenciais API (tokens serão gerados dinamicamente)
API_USER=
API_PASSWORD=

# URLs Web
BASE_URL=https://gestor.pigz.com.br

# URLs API
API_BASE_URL=https://api.pigz.com.br
API_ADMIN_BASE=https://api.pigz.com.br/admin/api

# Tokens (deixar em branco para usar geração automática)
API_TOKEN=

# Browser
HEADLESS=false
BROWSER_CHANNEL=chromium
START_MAXIMIZED=true
PAGE_ZOOM=80

# Timeouts
DEFAULT_TIMEOUT=5000
LONG_TIMEOUT=15000
SHORT_TIMEOUT=2000

# Logging
LOG_LEVEL=INFO
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_PATH=./tests/screenshots

# Testes
PYTEST_WORKERS=1
STOP_ON_FIRST_FAILURE=false

# Integrações
WEBHOOK_URL=
