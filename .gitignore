# ==============================================================================
# Git Ignore Configuration
# ==============================================================================
# Arquivo padrão para ignorar arquivos desnecessários no versionamento
# ==============================================================================

# ==============================================================================
# 🔒 SEGURANÇA - Nunca versionar dados sensíveis
# ==============================================================================
.env
# Variáveis de ambiente local específico
.env.local
# Variáveis de ambiente por ambiente
.env.*.local
# Variáveis de ambiente em pastas de ambiente
**/.env
# Chaves privadas
*.pem
# Chaves criptográficas
*.key

# ==============================================================================
# 🐍 Python
# ==============================================================================
__pycache__/
__pycache__/*
__pycache__/**
# Bytecode compilado
*.py[cod]
# Bytecode dinamicamente criado
*$py.class
# Extensões C compiladas
*.so
# Distribuição
dist/
# Build
build/
# Egg info
*.egg-info/
# Eggs
*.eggs/
# Python
.Python

# ==============================================================================
# 📦 Virtual Environment
# ==============================================================================
# Virtual environment padrão
.venv/
# Virtual environment alternativo
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# 🧪 Testes & Coverage
# ==============================================================================
# Cache do pytest
.pytest_cache/
# Arquivo de cobertura
.coverage
# Relatório HTML de cobertura
htmlcov/
# Relatório HTML de testes
report.html
# Arquivos de cobertura
.coverage.*

# ==============================================================================
# 📸 Screenshots & Logs
# ==============================================================================
# Screenshots de testes (locais)
tests/screenshots/
**/screenshots/*
**/screenshots/
# Arquivos de log
logs/
# Arquivos de log
*.log
# Log de debug
debug.log
videos/

# ==============================================================================
# 🎭 Playwright
# ==============================================================================
# Playwright auth cache
playwright/.auth/
# Resultados de teste
test-results/
# Relatório do Playwright
playwright-report/

# ==============================================================================
# 💻 IDE & Editor
# ==============================================================================
# Visual Studio Code
.vscode/
# JetBrains IDEs
.idea/
# Vim
*.swp
*.swo
# Editor temporário
*~
# macOS
.DS_Store
# Windows
Thumbs.db
# Eclipse
.project
.pydevproject
# Sublime
*.sublime-project
*.sublime-workspace

# ==============================================================================
# 📝 Editors & Temp Files
# ==============================================================================
# Backup
*.bak
# Arquivo temporário
*.tmp
# Arquivo original
*.orig
# Rejeição de patch
*.rej

# ==============================================================================
# 🔧 Ferramentas
# ==============================================================================
# Cache do mypy
.mypy_cache/
# dmypy.json
.dmypy.json
# Pyre type checker
.pyre/
# Pylint cache
.pylint.d/

# ==============================================================================
# 📊 Relatórios & Artefatos
# ==============================================================================
# JUnit XML (CI/CD)
*.xml
# Relatórios
reports/
allure-report/
allure-results/
history.jsonl
# Dados CSV
*.csv
# Dados Excel
*.xlsx
# PDFs
*.pdf
*.png

# ==============================================================================
# 💾 Arquivos de Banco de Dados
# ==============================================================================
*.db
*.sqlite
*.sqlite3

# ==============================================================================
# 📁 Diretórios Específicos do Projeto
# ==============================================================================
site-packages/

# ==============================================================================
# EXCEÇÕES - Arquivos que devem ser versionados mesmo ignorando padrões
# ==============================================================================
# Template deve ser versionado
!.env.example
# Dependências devem ser versionadas
!requirements.txt
# Setup devem ser versionados
!setup.py
